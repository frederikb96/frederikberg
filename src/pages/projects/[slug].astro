---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => Boolean(p.body?.trim()));
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, pitch, repo, links, image, image_alt, image_fit, layout } = project.data;
const { Content } = await render(project);
const allLinks = [...(repo ? [{ label: 'GitHub', url: repo }] : []), ...links];
---

<Base title={title} description={pitch} image={image} searchable>
  {
    layout === 'gallery' ? (
      <article class="mx-auto max-w-5xl px-5 pt-10 sm:pt-14">
        <a href="/projects/" class="text-sm font-bold text-link hover:text-amber-ink" data-pagefind-ignore>← Projects</a>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-brand sm:text-4xl">{title}</h1>
        <p class="mt-3 max-w-prose text-lg text-fg-muted">{pitch}</p>
        <div class="gallery mt-10">
          <Content />
        </div>
      </article>
    ) : (
      <article class="mx-auto max-w-3xl px-5 pt-10 sm:pt-14">
        <a href="/projects/" class="text-sm font-bold text-link hover:text-amber-ink" data-pagefind-ignore>← Projects</a>
        <header class="mt-4 mb-8">
          <h1 class="text-3xl leading-tight font-black tracking-tight text-brand sm:text-4xl" data-pagefind-meta="title">{title}</h1>
          <p class="mt-4 text-lg leading-relaxed text-fg-muted">{pitch}</p>
          {allLinks.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5 text-sm font-bold" data-pagefind-ignore>
              {allLinks.map((link) => (
                <li>
                  <a href={link.url} class="inline-flex items-center gap-1 text-link hover:text-amber-ink">
                    <Icon name={link.label === 'GitHub' ? 'github' : 'external'} class="h-4 w-4" />
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </header>
        <div class:list={['print mb-10 aspect-[16/9] overflow-hidden rounded-2xl', image_fit === 'contain' && 'flex items-center justify-center p-8']}>
          <Image
            src={image}
            alt={image_alt}
            widths={[640, 1024, 1440]}
            sizes="(min-width: 768px) 720px, 100vw"
            class:list={[image_fit === 'contain' ? 'max-h-full w-auto object-contain' : 'h-full w-full object-cover']}
          />
        </div>
        <div class="prose prose-lg max-w-none prose-headings:font-black prose-headings:tracking-tight">
          <Content />
        </div>
      </article>
    )
  }
</Base>

<style>
  .gallery :global(p) {
    display: contents;
  }
  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .gallery :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }
</style>
