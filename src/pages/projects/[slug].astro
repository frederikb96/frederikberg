---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => Boolean(p.body?.trim()));
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.pitch} image={project.data.image} searchable>
  <article class="mx-auto max-w-5xl px-5 pt-10 sm:pt-14">
    <a href="/projects/" class="text-sm font-bold text-link hover:text-amber-ink">← Projects</a>
    <h1 class="mt-3 text-3xl font-black tracking-tight text-brand sm:text-4xl">{project.data.title}</h1>
    <p class="mt-3 max-w-prose text-lg text-fg-muted">{project.data.pitch}</p>
    <div class="gallery mt-10">
      <Content />
    </div>
  </article>
</Base>

<style>
  .gallery :global(p) {
    display: contents;
  }
  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .gallery :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }
</style>
