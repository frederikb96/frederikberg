---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { getListedPosts } from '../../lib/blog';
import messenger from '../../assets/art/messenger.jpg';

const posts = await getListedPosts();
const filters = [
  { kind: 'all', label: 'All' },
  { kind: 'research', label: 'Research' },
  { kind: 'update', label: 'Updates' },
];
---

<Base title="Blog" description="Research posts with sources, and short updates on events, talks and projects.">
  <div class="mx-auto max-w-5xl px-5">
    <PageHeader title="Blog" image={messenger} imageAlt="A messenger hurrying along a winding path with a sealed letter, a lookout tower ahead">
      <p>
        This blog has two kinds of posts. <strong class="text-fg">Updates</strong> are short notes on things I did or took
        part in, a conference, a talk, a camp. <strong class="text-fg">Research</strong> posts are questions I worked
        through properly, with every claim backed by a source, from food footprints to German rail passenger rights.
      </p>
      <p class="mt-3">
        I publish the research so others can find it and build on it instead of doing the same work again, in the same
        spirit as putting code on GitHub. Code goes to my{' '}
        <a href="https://github.com/frederikb96" class="text-link underline decoration-moss underline-offset-4 hover:decoration-amber">GitHub</a>;
        written analysis ends up here. Corrections are always welcome by mail.
      </p>
    </PageHeader>

    <div class="mb-8 flex gap-2" role="group" aria-label="Filter posts">
      {
        filters.map((filter) => (
          <button
            type="button"
            data-filter={filter.kind}
            class="rounded-full border border-line bg-surface px-4 py-1.5 text-sm font-bold text-fg-muted hover:text-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-brand-fg"
            aria-pressed={filter.kind === 'all' ? 'true' : 'false'}
          >
            {filter.label}
          </button>
        ))
      }
    </div>

    <div id="posts">
      <PostList posts={posts} />
    </div>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('#posts [data-kind]');

  function apply(kind: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === kind)));
    items.forEach((item) => (item.hidden = kind !== 'all' && item.dataset.kind !== kind));
  }

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const kind = button.dataset.filter!;
      apply(kind);
      const url = new URL(location.href);
      if (kind === 'all') url.searchParams.delete('kind');
      else url.searchParams.set('kind', kind);
      history.replaceState(null, '', url);
    }),
  );

  const initial = new URLSearchParams(location.search).get('kind');
  if (initial === 'research' || initial === 'update') apply(initial);
</script>
