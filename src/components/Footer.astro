---
import { profile } from '../lib/data';
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<footer class="mt-24 border-t border-line/70" data-pagefind-ignore="all">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-8 text-sm text-fg-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {new Date().getFullYear()} {profile.name}, {profile.location}</p>
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <li>
        <a href={`mailto:${profile.email}`} class="inline-flex items-center gap-1.5 hover:text-brand"
          ><Icon name="mail" class="h-4 w-4" />Mail</a
        >
      </li>
      <li>
        <a href={profile.links.github} class="inline-flex items-center gap-1.5 hover:text-brand"
          ><Icon name="github" class="h-4 w-4" />GitHub</a
        >
      </li>
      <li>
        <a href={profile.links.scholar} class="inline-flex items-center gap-1.5 hover:text-brand"
          ><Icon name="scholar" class="h-4 w-4" />Scholar</a
        >
      </li>
      <li><a href={site.repo} class="hover:text-brand">Source of this site</a></li>
    </ul>
  </div>
</footer>
