---
// The AI note every blog post carries: a one-line badge under the title that jumps to
// the full note at the end of the post. Text per post language; `core+legal` adds the
// no-legal-advice sentence, `extra` one post-specific sentence after it.
interface Props {
  part: 'badge' | 'note';
  lang: 'en' | 'de';
  variant: 'core' | 'core+legal';
  extra?: string;
}
const { part, lang, variant, extra } = Astro.props;

const text = {
  en: {
    badge: 'Written with AI assistance — see the note at the end.',
    heading: 'A note on AI',
    core: 'Research and writing for this post were done together with my personal AI setup, mostly Claude. Every fact still has a source, quotations are taken from the original documents, and I read and checked the result before publishing. Corrections are welcome by mail.',
    legal: 'This is not legal advice.',
  },
  de: {
    badge: 'Mit KI-Unterstützung geschrieben — Hinweis am Ende.',
    heading: 'Hinweis zu KI',
    core: 'Recherche und Text sind zusammen mit meinem persönlichen KI-Setup entstanden, überwiegend Claude. Jede Aussage hat weiterhin eine Quelle, Zitate stammen aus den Originaldokumenten, und ich habe das Ergebnis vor der Veröffentlichung gelesen und geprüft. Korrekturen gerne per Mail.',
    legal: 'Das ist keine Rechtsberatung.',
  },
}[lang];

const sentences = [text.core, variant === 'core+legal' ? text.legal : undefined, extra].filter(Boolean);
---

{
  part === 'badge' ? (
    <a
      href="#ai-disclaimer"
      class="inline-flex items-center gap-1.5 text-sm text-fg-muted underline decoration-line underline-offset-4 hover:text-brand hover:decoration-amber"
      data-pagefind-ignore
    >
      {text.badge}
    </a>
  ) : (
    <aside
      id="ai-disclaimer"
      class="rounded-xl border border-line bg-surface-2/60 px-5 py-4 text-sm leading-relaxed text-fg-muted"
      data-pagefind-ignore
    >
      <h2 class="mb-1 text-sm font-bold text-fg">{text.heading}</h2>
      <p>{sentences.join(' ')}</p>
    </aside>
  )
}
