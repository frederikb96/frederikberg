---
import { site } from '../data/site';
import { profile } from '../lib/data';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => href.length > 1 && !href.includes('#') && path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/90 backdrop-blur-md" data-pagefind-ignore="all">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-5 py-3">
    <a href="/" class="text-lg font-black tracking-tight text-brand">{profile.name}</a>

    <form action="/search/" method="get" role="search" class="flex items-center gap-2 sm:order-last">
      <label for="site-search" class="sr-only">Search the site</label>
      <input
        id="site-search"
        name="q"
        type="search"
        placeholder="Search"
        class="hidden w-36 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm text-fg placeholder:text-fg-muted focus:w-48 focus:outline-none focus:ring-2 focus:ring-amber md:block md:transition-[width]"
      />
      <a href="/search/" class="rounded-full p-1.5 text-fg-muted hover:text-brand md:hidden" aria-label="Search">
        <Icon name="search" />
      </a>
    </form>

    <nav aria-label="Main" class="-mx-1.5 w-[calc(100%+0.75rem)] overflow-x-auto [scrollbar-width:none] sm:mx-0 sm:w-auto">
      <ul class="flex items-center justify-between text-[0.95rem] sm:justify-start sm:gap-2">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-full px-1.5 py-1 whitespace-nowrap sm:px-2.5 transition-colors hover:bg-surface-2 hover:text-brand',
                  isActive(item.href) ? 'font-bold text-brand' : 'text-fg-muted',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
