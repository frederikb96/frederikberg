---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { profile } from '../lib/data';

interface Props {
  publication: CollectionEntry<'publications'>;
  abstract?: boolean;
}
const { publication, abstract = false } = Astro.props;
const { title, authors, date, venue, venue_short, doi, pdf, bib, image, image_caption } = publication.data;
const base = `/publications/${publication.id}/`;
const { Content } = await render(publication);
---

<li id={publication.id} class="grid gap-5 sm:grid-cols-[12rem_minmax(0,1fr)]">
  <div class="print hidden aspect-[4/3] overflow-hidden rounded-xl sm:block">
    <Image src={image} alt={image_caption} width={384} class="h-full w-full object-cover" />
  </div>
  <div>
    <h3 class="text-lg leading-snug font-bold text-brand">{title}</h3>
    <p class="mt-1 text-sm text-fg-muted">
      {
        authors.map((author, i) => (
          <>
            {author === profile.name ? <strong class="text-fg">{author}</strong> : author}
            {i < authors.length - 1 && ', '}
          </>
        ))
      }
    </p>
    <p class="mt-1 text-sm text-fg-muted">
      <em>{venue}</em> ({venue_short}), {date.getUTCFullYear()}
    </p>
    {
      abstract && (
        <div class="prose prose-sm mt-3 max-w-none">
          <Content />
        </div>
      )
    }
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-sm font-bold">
      <li>
        <a href={`${base}${pdf}`} class="inline-flex items-center gap-1.5 text-link hover:text-amber-ink">
          <Icon name="file" class="h-4 w-4" />PDF
        </a>
      </li>
      <li>
        <a href={doi} class="inline-flex items-center gap-1.5 text-link hover:text-amber-ink">
          <Icon name="external" class="h-4 w-4" />DOI
        </a>
      </li>
      <li>
        <a href={`${base}${bib}`} class="inline-flex items-center gap-1.5 text-link hover:text-amber-ink">
          <Icon name="cv" class="h-4 w-4" />Cite (BibTeX)
        </a>
      </li>
    </ul>
  </div>
</li>
