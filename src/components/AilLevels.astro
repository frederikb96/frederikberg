---
// The seven AI Influence Levels as a table: badge, name, one-line meaning.
import AilBadge from './AilBadge.astro';
import { ailLevels, type Lang } from '../lib/ail';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const head = lang === 'de' ? { level: 'Stufe', meaning: 'Bedeutung' } : { level: 'Level', meaning: 'Meaning' };
---

<table class="not-prose w-full border-collapse text-left text-base">
  <thead>
    <tr class="border-b border-line text-sm text-fg-muted">
      <th scope="col" class="w-px py-2 pr-6 font-bold whitespace-nowrap">{head.level}</th>
      <th scope="col" class="py-2 font-bold">{head.meaning}</th>
    </tr>
  </thead>
  <tbody>
    {
      ailLevels.map(({ level, name, meaning }) => (
        <tr id={`level-${level}`} class="border-b border-line/70 align-top">
          <td class="py-4 pr-6">
            <AilBadge level={level} lang={lang} />
          </td>
          <td class="py-4">
            <p class="font-bold text-fg">{name[lang]}</p>
            <p class="mt-1 text-fg-muted">{meaning[lang]}</p>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
